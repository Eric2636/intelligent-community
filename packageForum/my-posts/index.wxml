<import src="../../templates/forum-list-media.wxml" />
<view class="my-posts-page">
  <view wx:if="{{showManualLoad}}" class="auth-manual-load" aria-role="region" aria-label="登录成功，请手动加载内容">
    <view class="auth-manual-load__text">登录成功，请点击加载内容</view>
    <t-button theme="primary" size="medium" bindtap="onManualLoad">加载内容</t-button>
  </view>
  <t-pull-down-refresh
    wx:if="{{!showManualLoad}}"
    value="{{loading}}"
    loadingProps="{{loadingProps}}"
    bind:refresh="onPullDownRefresh"
  >
    <view class="post-list">
      <view class="post-card" wx:for="{{postList}}" wx:key="id" bind:tap="goPost" data-id="{{item.id || item._id}}">
        <view class="post-title">{{item.title}}</view>
        <view class="post-content">{{item.content}}</view>
        <template is="forumListMedia" data="{{item: item}}" />
        <view class="post-meta">
          <text class="post-meta__time">{{item.createTime}}</text>
          <text class="post-meta__reply-count">{{item.replyCount}} 回复</text>
        </view>
      </view>
    </view>
    <t-empty wx:if="{{!loading && postList.length === 0}}" description="暂无发布的帖子" />
  </t-pull-down-refresh>
</view>
<auth-login-dialog id="auth-login-dialog" bindauthorized="onAuthorized" />
