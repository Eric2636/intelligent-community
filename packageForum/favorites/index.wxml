<import src="../../templates/forum-list-media.wxml" />
<nav title-text="我的收藏" show-back="{{true}}" />
<view class="favorites-page">
  <view wx:if="{{showManualLoad}}" class="auth-manual-load" aria-role="region" aria-label="登录成功，请手动加载内容">
    <view class="auth-manual-load__text">登录成功，请点击加载内容</view>
    <t-button theme="primary" size="medium" bindtap="onManualLoad">加载内容</t-button>
  </view>
  <block wx:if="{{!showManualLoad}}">
    <view wx:if="{{loading}}" class="favorites-loading">
      <t-loading theme="dots" size="48rpx" />
    </view>
    <view wx:else class="favorites-list">
      <view class="favorites-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id || item._id}}" bindtap="goPost">
        <text class="favorites-item__title">{{item.title}}</text>
        <template is="forumListMedia" data="{{item: item}}" />
        <view class="favorites-item__meta">
          <text class="favorites-item__time">{{item.createTime}}</text>
          <text class="favorites-item__count">{{item.replyCount || 0}} 回复</text>
          <text class="favorites-item__count">{{item.likeCount || 0}} 赞</text>
        </view>
      </view>
    </view>
    <t-empty wx:if="{{!loading && list.length === 0}}" description="暂无收藏的帖子" />
  </block>
</view>
<auth-login-dialog id="auth-login-dialog" bindauthorized="onAuthorized" />
