<nav title-text="发帖" show-back="{{true}}" />
<view class="publish-page">
  <view class="publish-form">
    <view class="publish-field">
      <input
        class="publish-field__input publish-field__input--title"
        placeholder="请输入标题"
        value="{{title}}"
        maxlength="60"
        bindinput="onTitleInput"
      />
    </view>

    <view wx:if="{{canManageForumPosts && !editing}}" class="publish-field publish-admin-options">
      <view class="publish-admin-options__group">
        <view class="publish-admin-options__label">活动类型</view>
        <view class="publish-segmented">
          <view class="publish-segment {{featureType === 'CONTENT' ? 'publish-segment--active' : ''}}" data-value="CONTENT" bindtap="onFeatureTypeSelect">内容</view>
          <view class="publish-segment {{featureType === 'REGISTRATION' ? 'publish-segment--active' : ''}}" data-value="REGISTRATION" bindtap="onFeatureTypeSelect">活动报名</view>
        </view>
      </view>
      <block wx:if="{{featureType === 'REGISTRATION'}}">
        <view class="publish-admin-options__group"><view class="publish-admin-options__label">报名人数上限</view><input class="publish-field__input" type="number" placeholder="请输入报名人数上限" value="{{registrationCapacity}}" bindinput="onCapacityInput" /></view>
        <view class="publish-admin-options__group"><view class="publish-admin-options__label">报名截止日期</view><picker mode="date" value="{{registrationDeadlineAt}}" bindchange="onDeadlineChange"><view class="publish-admin-options__picker"><t-icon name="calendar" size="34rpx" /><text class="publish-admin-options__picker-text">{{registrationDeadlineAt || '请选择报名截止日期'}}</text><t-icon name="chevron-right" size="32rpx" /></view></picker></view>
      </block>
      <view class="publish-admin-options__group publish-admin-options__group--settings">
        <view class="publish-admin-options__label">发布设置</view>
        <view class="publish-admin-options__pin"><text>置顶</text><t-switch value="{{pinned}}" bind:change="onPinnedChange" /></view>
      </view>
    </view>
    <view class="publish-field">
      <textarea
        class="publish-field__input publish-field__textarea"
        placeholder="请输入正文"
        value="{{content}}"
        maxlength="2000"
        auto-height
        focus="{{contentFocus}}"
        bindinput="onContentInput"
      />
      <view class="publish-field__toolbar">
        <view class="publish-field__emoji" bindtap="onEmojiHint">
          <t-icon name="{{showEmojiPanel ? 'smile-filled' : 'smile'}}" size="36rpx" color="#007aff" />
          <text>表情</text>
        </view>
        <view class="publish-field__hint">点击表情插入；最多 9 张图、2 段视频</view>
      </view>
      <emoji-panel wx:if="{{showEmojiPanel}}" bindselect="onEmojiSelect" />
    </view>

    <view class="media-picker" wx:if="{{mediaImages.length || mediaVideos.length}}">
      <view class="media-picker__grid">
        <block wx:for="{{mediaImages}}" wx:for-index="idx" wx:key="*this">
          <view class="media-picker__cell">
            <image
              class="media-picker__img"
              src="{{item}}"
              mode="aspectFill"
              data-urls="{{mediaImages}}"
              data-current="{{item}}"
              bindtap="onPreviewImage"
            />
            <view class="media-picker__del" data-kind="image" data-index="{{idx}}" catchtap="onRemoveMedia">×</view>
          </view>
        </block>
        <block wx:for="{{mediaVideos}}" wx:for-index="vidx" wx:key="*this">
          <view class="media-picker__cell media-picker__cell--video">
            <video class="media-picker__video" src="{{item}}" object-fit="cover" show-center-play-btn="{{true}}" controls="{{false}}" />
            <view class="media-picker__del" data-kind="video" data-index="{{vidx}}" catchtap="onRemoveMedia">×</view>
          </view>
        </block>
      </view>
    </view>
    <view
      class="media-picker__add"
      bindtap="onAddMedia"
      wx:if="{{mediaImages.length + mediaVideos.length < 11}}"
    >
      + 添加图片或视频
    </view>
    <view wx:if="{{canManageForumPosts}}" class="attachment-picker">
      <view class="attachment-picker__head"><text>附件（最多5个，单个20MB）</text></view>
      <view class="attachment-picker__action {{attachmentUploading ? 'attachment-picker__action--busy' : ''}}" bindtap="onAddAttachment">
        <t-icon name="attach" size="36rpx" /><text wx:if="{{!attachmentUploading}}">添加附件</text><text wx:elif="{{attachmentStage === 'selecting'}}">正在选择文件</text><text wx:elif="{{attachmentStage === 'hashing'}}">正在计算文件哈希</text><text wx:elif="{{attachmentStage === 'checking'}}">正在检查秒传</text><text wx:else>正在上传</text>
      </view>
      <view wx:for="{{attachments}}" wx:key="mediaAssetId" class="attachment-picker__item">
        <text class="attachment-picker__name">{{item.name}}</text><text class="attachment-picker__size">{{item.sizeBytes}} B</text><text class="attachment-picker__remove" data-index="{{index}}" bindtap="onRemoveAttachment">移除</text>
      </view>
    </view>

    <t-button
      class="publish-submit"
      theme="primary"
      size="large"
      block
      bindtap="submit"
      loading="{{submitting}}"
    >
      {{editing ? '保存' : '发布'}}
    </t-button>
  </view>
</view>
<auth-login-dialog id="auth-login-dialog" bindauthorized="onAuthorized" />
