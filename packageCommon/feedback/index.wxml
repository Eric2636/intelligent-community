<view class="feedback-page">
  <view class="form-container">
    <view class="form-item">
      <view class="form-label">请告诉我们你的建议</view>
      <t-textarea
        value="{{content}}"
        placeholder="请输入反馈内容（1-500个字符）"
        bind:change="onContentInput"
        maxlength="-1"
        autosize
      />
      <view class="feedback-counter {{contentLength > 500 ? 'feedback-counter--error' : ''}}">
        {{contentLength}} / 500
      </view>
    </view>

    <view class="form-actions">
      <t-button
        theme="primary"
        size="large"
        bind:tap="submit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >
        提交反馈
      </t-button>
    </view>
  </view>
</view>
<auth-login-dialog id="auth-login-dialog" bindauthorized="onAuthorized" />
