<view class="my-list-page">
  <t-pull-down-refresh
    value="{{loading}}"
    loadingProps="{{loadingProps}}"
    bind:refresh="onPullDownRefresh"
  >
    <view class="item-grid">
      <view class="item-card" wx:for="{{itemList}}" wx:key="id" bind:tap="goDetail" data-id="{{item.id}}">
        <view class="item-status {{item.visibility === 'ONLINE' ? 'item-status--online' : 'item-status--offline'}}">
          {{item.visibility === 'ONLINE' ? '已上架' : '待上架'}}
        </view>
        <image wx:if="{{item.coverImage}}" class="item-image" src="{{item.coverImage}}" mode="aspectFill" lazy-load />
        <view wx:else class="item-image item-image--placeholder">暂无图片</view>
        <view class="item-info">
          <view class="item-title">{{item.title}}</view>
          <view class="item-price">¥{{item.price}}</view>
          <view class="item-category">{{item.categoryName || item.categoryId}}</view>
        </view>
      </view>
    </view>
    <t-empty wx:if="{{!loading && itemList.length === 0}}" description="暂无发布的商品" />
  </t-pull-down-refresh>
</view>
