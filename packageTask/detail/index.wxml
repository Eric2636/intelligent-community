<nav title-text="{{task ? task.title : '任务详情'}}" show-back="{{true}}" fallback-url="/pages/task/index" />
<view class="detail-page">
  <view wx:if="{{loading}}" class="detail-loading"><t-loading theme="dots" size="48rpx" /></view>
  <block wx:elif="{{task}}">
    <view class="detail-card">
      <view class="detail-card__reward">感谢金 {{task.reward || '0'}}</view>
      <view class="detail-card__tag detail-card__tag--{{task.status}}">{{STATUS_TEXT[task.status]}}</view>
      <view class="detail-card__title">{{task.title}}</view>
      <view class="detail-card__desc" wx:if="{{task.desc}}">{{task.desc}}</view>
      <view class="detail-card__media" wx:if="{{task.images.length || task.videos.length}}">
        <view class="detail-card__media-grid">
          <block wx:for="{{task.images}}" wx:key="*this">
            <image
              class="detail-card__media-img"
              src="{{item}}"
              mode="aspectFill"
              data-current="{{item}}"
              bindtap="onPreviewTaskImages"
            />
          </block>
          <block wx:for="{{task.videos}}" wx:key="*this">
            <video
              class="detail-card__media-video"
              src="{{item}}"
              controls
              show-center-play-btn
              object-fit="contain"
            />
          </block>
        </view>
      </view>
      <view class="detail-card__row">
        <text class="detail-card__label">地点</text>
        <text class="detail-card__value">{{task.location}}</text>
      </view>
      <view class="detail-card__row">
        <text class="detail-card__label">发布者</text>
        <view class="detail-card__value detail-card__person">
          <t-avatar class="detail-card__avatar" image="{{task.publisherAvatar}}" icon="{{task.publisherAvatar ? '' : 'user'}}" size="32rpx" alt="{{task.publisherName || '发布者头像'}}" />
          <text class="detail-card__person-name">{{task.publisherName || '发布者'}}</text>
          <text wx:if="{{task.userTagLabel}}" class="identity-tag identity-tag--{{task.userTagType}}">{{task.userTagLabel}}</text>
        </view>
      </view>
      <view class="detail-card__row" wx:if="{{task.takerName}}">
        <text class="detail-card__label">接单人</text>
        <view class="detail-card__value detail-card__person">
          <t-avatar class="detail-card__avatar" image="{{task.takerAvatar}}" icon="{{task.takerAvatar ? '' : 'user'}}" size="32rpx" alt="{{task.takerName || '接单人头像'}}" />
          <text class="detail-card__person-name">{{task.takerName}}</text>
        </view>
      </view>
      <view class="detail-card__row">
        <text class="detail-card__label">发布时间</text>
        <text class="detail-card__value">{{task.createdAt}}</text>
      </view>
      <view wx:if="{{task.status === 'in_progress' && task.claimedAt}}" class="detail-card__row">
        <text class="detail-card__label">领取时间</text>
        <text class="detail-card__value">{{task.claimedAt}}</text>
      </view>
      <view wx:if="{{task.proofText || task.proofImages.length}}" class="detail-card__proof">
        <text class="detail-card__label">完成凭证</text>
        <text wx:if="{{task.proofText}}" class="detail-card__proof-text">{{task.proofText}}</text>
        <view wx:if="{{task.proofImages.length}}" class="detail-card__proof-images">
          <image
            wx:for="{{task.proofImages}}"
            wx:key="*this"
            class="detail-card__proof-image"
            src="{{item}}"
            mode="aspectFill"
            data-current="{{item}}"
            bindtap="onPreviewProofImages"
          />
        </view>
        <text class="detail-card__time" wx:if="{{task.completedAt}}">{{task.completedAt}}</text>
      </view>
    </view>

    <button class="detail-share-btn" open-type="share">
      <t-icon name="share" size="36rpx" />
      <text>分享给邻居</text>
    </button>

    <view class="detail-actions">
      <block wx:if="{{task.status === 'draft' && isPublisher}}">
        <t-button theme="primary" size="large" block bindtap="onPublishDraft">发布任务</t-button>
        <t-button theme="default" size="large" block bindtap="onDeleteTask" style="margin-top: 16rpx;">删除草稿</t-button>
        <view class="detail-actions__hint">提示：草稿不会出现在大厅，发布后他人才能领取。</view>
      </block>
      <block wx:elif="{{task.status === 'pending_take' && !isPublisher}}">
        <t-button theme="primary" size="large" block bindtap="onClaim">领取任务</t-button>
        <view class="detail-actions__hint">提示：领取后你将成为接单人，需要完成任务并提交完成说明。</view>
      </block>
      <block wx:elif="{{task.status === 'in_progress' && isTaker}}">
        <view class="detail-proof">
          <textarea placeholder="请输入完成说明" value="{{proofText}}" focus="{{proofFocus}}" bindinput="onProofInput" class="detail-proof__input" />
          <view class="detail-proof__toolbar">
            <view class="detail-proof__emoji" bindtap="onTaskEmojiHint">
              <t-icon name="{{showProofEmojiPanel ? 'smile-filled' : 'smile'}}" size="36rpx" color="#007aff" />
              <text>表情</text>
            </view>
            <text class="detail-proof__hint">点击表情插入</text>
          </view>
          <view wx:if="{{proofImages.length}}" class="detail-proof__images">
            <view wx:for="{{proofImages}}" wx:key="*this" class="detail-proof__image-wrap">
              <image
                class="detail-proof__image"
                src="{{item}}"
                mode="aspectFill"
                data-current="{{item}}"
                bindtap="onPreviewEditableProofImages"
              />
              <view
                class="detail-proof__remove"
                data-index="{{index}}"
                catchtap="onRemoveProofImage"
              >×</view>
            </view>
          </view>
          <view class="detail-proof__action">
            <t-button
              theme="primary"
              variant="outline"
              size="large"
              block
              loading="{{proofUploading}}"
              disabled="{{proofUploading || proofImages.length >= 9}}"
              bindtap="onAddProofImages"
            >{{proofImages.length >= 9 ? '最多上传 9 张图片' : '上传完成图片'}}</t-button>
          </view>
          <emoji-panel wx:if="{{showProofEmojiPanel}}" bindselect="onProofEmojiSelect" />
          <view class="detail-proof__action detail-proof__action--spaced">
            <t-button theme="primary" size="large" block bindtap="onSubmitComplete">提交完成</t-button>
          </view>
          <view class="detail-proof__action detail-proof__action--spaced">
            <t-button theme="default" size="large" block bindtap="onAbandon">放弃任务</t-button>
          </view>
        </view>
        <view class="detail-actions__hint">提示：你也可以放弃任务，任务将重新回到待领取。</view>
      </block>
      <block wx:elif="{{task.status === 'in_progress' && isPublisher}}">
        <t-button theme="danger" variant="outline" size="large" block bindtap="onCancel">取消任务</t-button>
        <view class="detail-actions__hint">提示：取消后会通知接单人，请先与对方沟通。</view>
      </block>
      <block wx:elif="{{task.status === 'pending_confirm' && isPublisher}}">
        <t-button theme="primary" size="large" block bindtap="onConfirmComplete">确认完成</t-button>
        <t-button theme="danger" variant="outline" size="large" block bindtap="onRejectComplete" custom-class="detail-actions__secondary">驳回</t-button>
        <t-button theme="danger" variant="outline" size="large" block bindtap="onCancel" custom-class="detail-actions__secondary">取消任务</t-button>
        <view class="detail-actions__hint">提示：确认完成前请先与接单人线下结算感谢金。</view>
      </block>
      <block wx:elif="{{task.status === 'pending_take' && isPublisher}}">
        <t-button theme="danger" variant="outline" size="large" block bindtap="onCancel">撤销发布</t-button>
        <view class="detail-actions__hint">提示：撤销发布后该任务将不再可领取。</view>
      </block>
      <block wx:elif="{{task.status === 'cancelled' && isPublisher}}">
        <t-button theme="primary" size="large" block bindtap="onRepublish">重新发布</t-button>
        <t-button theme="default" size="large" block bindtap="onDeleteTask" style="margin-top: 16rpx;">删除任务</t-button>
        <view class="detail-actions__hint">提示：已撤销的任务可以重新发布；删除后不可恢复。</view>
      </block>
      <block wx:elif="{{task.status === 'completed' && (isPublisher || isTaker) && otherPartyId}}">
        <t-button theme="primary" size="large" block bindtap="onOpenRating">评价 {{otherPartyName}}</t-button>
        <view class="detail-actions__hint">提示：评价仅用于展示信用，不涉及支付。</view>
      </block>
    </view>

    <view wx:if="{{showRating}}" class="detail-rating-mask" catchtap="onCloseRating">
      <view class="detail-rating-panel" catchtap="">
        <view class="detail-rating__title">评价 {{otherPartyName}}</view>
        <view class="detail-rating__stars">
          <text class="detail-rating__star {{ratingScore >= 1 ? 'on' : ''}}" data-score="1" bindtap="onRatingStar">★</text>
          <text class="detail-rating__star {{ratingScore >= 2 ? 'on' : ''}}" data-score="2" bindtap="onRatingStar">★</text>
          <text class="detail-rating__star {{ratingScore >= 3 ? 'on' : ''}}" data-score="3" bindtap="onRatingStar">★</text>
          <text class="detail-rating__star {{ratingScore >= 4 ? 'on' : ''}}" data-score="4" bindtap="onRatingStar">★</text>
          <text class="detail-rating__star {{ratingScore >= 5 ? 'on' : ''}}" data-score="5" bindtap="onRatingStar">★</text>
        </view>
        <textarea placeholder="请输入评价" value="{{ratingComment}}" bindinput="onRatingComment" class="detail-rating__input" />
        <t-button theme="primary" size="medium" block bindtap="onSubmitRating">提交评价</t-button>
      </view>
    </view>
  </block>
  <view wx:else class="detail-loading">任务不存在</view>
</view>
<auth-login-dialog id="auth-login-dialog" />
