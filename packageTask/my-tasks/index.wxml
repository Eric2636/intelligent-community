<view class="my-tasks-page">
  <view class="my-tasks-tabs" wx:if="{{showTabs}}">
    <view
      class="my-tasks-tabs__item {{activeTab === 'published' ? 'my-tasks-tabs__item--active' : ''}}"
      data-tab="published"
      bindtap="onTabTap"
    >我发布的</view>
    <view
      class="my-tasks-tabs__item {{activeTab === 'taken' ? 'my-tasks-tabs__item--active' : ''}}"
      data-tab="taken"
      bindtap="onTabTap"
    >我领取的</view>
  </view>

  <view wx:if="{{showManualLoad}}" class="auth-manual-load" aria-role="region" aria-label="登录成功，请手动加载内容">
    <view class="auth-manual-load__text">登录成功，请点击加载内容</view>
    <t-button theme="primary" size="medium" bindtap="onManualLoad">加载内容</t-button>
  </view>

  <view wx:if="{{!showManualLoad}}" class="tab-content">
    <t-pull-down-refresh
      value="{{loading}}"
      loadingProps="{{loadingProps}}"
      bind:refresh="onPullDownRefresh"
    >
      <view wx:if="{{loading}}" class="task-loading">
        <view class="task-skeleton" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="task-skeleton__line task-skeleton__title"></view>
          <view class="task-skeleton__line task-skeleton__desc"></view>
          <view class="task-skeleton__line task-skeleton__meta"></view>
        </view>
      </view>

      <block wx:else>
        <view wx:if="{{activeTab === 'published'}}" class="task-list list-fade-in">
          <view
            class="task-card task-card--with-tag"
            wx:for="{{publishedList}}"
            wx:for-item="card"
            wx:for-index="cardIdx"
            wx:key="id"
            data-id="{{card.id}}"
            bindtap="goDetail"
          >
            <view class="task-card__tag task-card__tag--{{card.status}}">{{card.statusLabel}}</view>
            <view class="task-card__meta-row">
              <view class="task-card__publisher">
                <t-avatar class="task-card__publisher-avatar" image="{{card.publisherAvatar}}" icon="{{card.publisherAvatar ? '' : 'user'}}" size="48rpx" alt="{{card.publisherName || '发布者头像'}}" />
                <text class="task-card__publisher-name">{{card.publisherName || '发布者'}}</text>
                <text wx:if="{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}" class="identity-tag identity-tag--{{card.contentTagType || (card.adminLabel ? 'admin' : (card.publisherIdentityLabel === '小区外人员' ? 'outsider' : 'owner'))}}">{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}</text>
              </view>
              <view class="task-card__reward">感谢金 {{card.reward || '0'}}</view>
            </view>
            <text class="task-card__title">{{card.title}}</text>
            <view class="task-card__thumbs" wx:if="{{card.images.length}}">
              <block wx:for="{{card.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this">
                <view wx:if="{{imgIdx < 3}}" class="task-card__thumb-wrap">
                  <image
                    class="task-card__thumb"
                    src="{{img}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    data-kind="published"
                    data-card-index="{{cardIdx}}"
                    data-current="{{img}}"
                    catchtap="onPreviewListImages"
                  />
                  <view wx:if="{{imgIdx === 2 && card.images.length > 3}}" class="task-card__thumb-more">+{{card.images.length - 3}}</view>
                </view>
              </block>
            </view>
            <view class="task-card__media-hint" wx:if="{{card.videos.length}}">含视频</view>
            <text class="task-card__desc">{{card.desc}}</text>
            <view class="task-card__meta">{{card.createdAt}}</view>
          </view>
          <t-empty wx:if="{{!loading && publishedList.length === 0}}" description="暂无发布的任务" />
        </view>

        <view wx:if="{{activeTab === 'draft'}}" class="task-list list-fade-in">
          <view
            class="task-card task-card--with-tag"
            wx:for="{{draftList}}"
            wx:for-item="card"
            wx:for-index="cardIdx"
            wx:key="id"
            data-id="{{card.id}}"
            bindtap="goDetail"
          >
            <view class="task-card__tag task-card__tag--{{card.status}}">{{card.statusLabel}}</view>
            <view class="task-card__meta-row">
              <view class="task-card__publisher">
                <t-avatar class="task-card__publisher-avatar" image="{{card.publisherAvatar}}" icon="{{card.publisherAvatar ? '' : 'user'}}" size="48rpx" alt="{{card.publisherName || '发布者头像'}}" />
                <text class="task-card__publisher-name">{{card.publisherName || '发布者'}}</text>
                <text wx:if="{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}" class="identity-tag identity-tag--{{card.contentTagType || (card.adminLabel ? 'admin' : (card.publisherIdentityLabel === '小区外人员' ? 'outsider' : 'owner'))}}">{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}</text>
              </view>
              <view class="task-card__reward">感谢金 {{card.reward || '0'}}</view>
            </view>
            <text class="task-card__title">{{card.title}}</text>
            <view class="task-card__thumbs" wx:if="{{card.images.length}}">
              <block wx:for="{{card.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this">
                <view wx:if="{{imgIdx < 3}}" class="task-card__thumb-wrap">
                  <image
                    class="task-card__thumb"
                    src="{{img}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    data-kind="draft"
                    data-card-index="{{cardIdx}}"
                    data-current="{{img}}"
                    catchtap="onPreviewListImages"
                  />
                  <view wx:if="{{imgIdx === 2 && card.images.length > 3}}" class="task-card__thumb-more">+{{card.images.length - 3}}</view>
                </view>
              </block>
            </view>
            <view class="task-card__media-hint" wx:if="{{card.videos.length}}">含视频</view>
            <text class="task-card__desc">{{card.desc}}</text>
            <view class="task-card__meta">{{card.createdAt}}</view>
          </view>
          <t-empty wx:if="{{!loading && draftList.length === 0}}" description="{{emptyText}}" />
        </view>

        <view wx:if="{{activeTab === 'cancelled'}}" class="task-list list-fade-in">
          <view
            class="task-card task-card--with-tag"
            wx:for="{{cancelledList}}"
            wx:for-item="card"
            wx:for-index="cardIdx"
            wx:key="id"
            data-id="{{card.id}}"
            bindtap="goDetail"
          >
            <view class="task-card__tag task-card__tag--{{card.status}}">{{card.statusLabel}}</view>
            <view class="task-card__meta-row">
              <view class="task-card__publisher">
                <t-avatar class="task-card__publisher-avatar" image="{{card.publisherAvatar}}" icon="{{card.publisherAvatar ? '' : 'user'}}" size="48rpx" alt="{{card.publisherName || '发布者头像'}}" />
                <text class="task-card__publisher-name">{{card.publisherName || '发布者'}}</text>
                <text wx:if="{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}" class="identity-tag identity-tag--{{card.contentTagType || (card.adminLabel ? 'admin' : (card.publisherIdentityLabel === '小区外人员' ? 'outsider' : 'owner'))}}">{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}</text>
              </view>
              <view class="task-card__reward">感谢金 {{card.reward || '0'}}</view>
            </view>
            <text class="task-card__title">{{card.title}}</text>
            <view class="task-card__thumbs" wx:if="{{card.images.length}}">
              <block wx:for="{{card.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this">
                <view wx:if="{{imgIdx < 3}}" class="task-card__thumb-wrap">
                  <image
                    class="task-card__thumb"
                    src="{{img}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    data-kind="cancelled"
                    data-card-index="{{cardIdx}}"
                    data-current="{{img}}"
                    catchtap="onPreviewListImages"
                  />
                  <view wx:if="{{imgIdx === 2 && card.images.length > 3}}" class="task-card__thumb-more">+{{card.images.length - 3}}</view>
                </view>
              </block>
            </view>
            <view class="task-card__media-hint" wx:if="{{card.videos.length}}">含视频</view>
            <text class="task-card__desc">{{card.desc}}</text>
            <view class="task-card__meta">{{card.createdAt}}</view>
          </view>
          <t-empty wx:if="{{!loading && cancelledList.length === 0}}" description="{{emptyText}}" />
        </view>

        <view wx:if="{{activeTab === 'taken'}}" class="task-list list-fade-in">
          <view
            class="task-card task-card--with-tag"
            wx:for="{{takenList}}"
            wx:for-item="card"
            wx:for-index="cardIdx"
            wx:key="id"
            data-id="{{card.id}}"
            bindtap="goDetail"
          >
            <view class="task-card__tag task-card__tag--{{card.status}}">{{card.statusLabel}}</view>
            <view class="task-card__meta-row">
              <view class="task-card__publisher">
                <t-avatar class="task-card__publisher-avatar" image="{{card.publisherAvatar}}" icon="{{card.publisherAvatar ? '' : 'user'}}" size="48rpx" alt="{{card.publisherName || '发布者头像'}}" />
                <text class="task-card__publisher-name">{{card.publisherName || '发布者'}}</text>
                <text wx:if="{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}" class="identity-tag identity-tag--{{card.contentTagType || (card.adminLabel ? 'admin' : (card.publisherIdentityLabel === '小区外人员' ? 'outsider' : 'owner'))}}">{{card.contentTagLabel || card.adminLabel || card.publisherIdentityLabel}}</text>
              </view>
              <view class="task-card__reward">感谢金 {{card.reward || '0'}}</view>
            </view>
            <text class="task-card__title">{{card.title}}</text>
            <view class="task-card__thumbs" wx:if="{{card.images.length}}">
              <block wx:for="{{card.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this">
                <view wx:if="{{imgIdx < 3}}" class="task-card__thumb-wrap">
                  <image
                    class="task-card__thumb"
                    src="{{img}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    data-kind="taken"
                    data-card-index="{{cardIdx}}"
                    data-current="{{img}}"
                    catchtap="onPreviewListImages"
                  />
                  <view wx:if="{{imgIdx === 2 && card.images.length > 3}}" class="task-card__thumb-more">+{{card.images.length - 3}}</view>
                </view>
              </block>
            </view>
            <view class="task-card__media-hint" wx:if="{{card.videos.length}}">含视频</view>
            <text class="task-card__desc">{{card.desc}}</text>
            <view class="task-card__meta">{{card.createdAt}}</view>
          </view>
          <t-empty wx:if="{{!loading && takenList.length === 0}}" description="暂无领取的任务" />
        </view>
      </block>
    </t-pull-down-refresh>
  </view>
</view>
<auth-login-dialog id="auth-login-dialog" bindauthorized="onAuthorized" />
